# ============================================================
# SEGURIDAD — interruptor maestro de ejecución real
# ============================================================
# Mientras sea "false" (o la variable no exista), cualquier intento de
# operar dinero real aborta con RuntimeError. Para habilitar ejecución
# real (fase 3, aún no implementada) se exige ADEMÁS live_trading: true
# en config/config.yaml. Doble llave a propósito.
LIVE_TRADING=false

